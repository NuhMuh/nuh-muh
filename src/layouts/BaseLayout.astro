---
import '../styles/global.css';
import QuillButton from '../components/QuillButton.astro';
interface Props { title: string; }
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <!-- 파비콘 — 엠블럼(N–M 리거처). 워드마크는 가로로 길어 정사각 자리에 안 맞는다.
       ★참조를 명시한다 — 이전에는 Astro의 기본 경로 자동 인식에 의존해 기본 로고가 떴다.
       512 PNG 한 장이 브라우저 탭·북마크·홈 화면 바로가기(iOS 180 / 안드로이드 192·512)를 모두 커버한다.
       .ico는 구형 브라우저 대비(16/32/48 다중 해상도 내장). -->
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" href="/favicon-512.png" />
  <link rel="apple-touch-icon" href="/favicon-512.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Unicase:wght@500;600&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Noto+Serif+KR:wght@300;400;500;600&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet" />
</head>
<body>
    <div class="paper-frame" aria-hidden="true" style="position:fixed; inset:0; pointer-events:none; z-index:200; box-shadow: inset 0 0 70px 0 rgba(88,70,40,0.32), inset 0 0 20px 0 rgba(66,52,28,0.22);"></div>
  <QuillButton />
  <slot />
</body>
</html>
