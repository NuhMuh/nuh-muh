---
// 내 방 (1차 시공 · 2026-09-03 재작성)
//
// ★주소를 /room으로 유지한다. /welcome의 [둘러본다]와 GothicDoor가 여기를 가리키는데
//   그 사실이 어느 문서에도 없었다. 주소를 바꾸면 keyholder가 된 직후 빈 곳에 도착한다.
//
// ★★시점 — 방 밖에서 육면체를 구경하는 것이 아니라 방 안에 서 있는 것이다.
//   1차 시도가 화면 가운데 작은 상자를 그렸고 그것은 틀렸다(운영자 판정).
//   육면체는 개념이지 그려야 할 물건이 아니다.
//   정면 벽이 화면을 꽉 채우고, 양옆 벽은 아주 가파르게 기울어 가장자리에 힌트만 남는다.
//   돌리면 그 옆벽이 정면으로 펴지고 보던 벽이 기울어지며 사라진다 — 화면 전체가 돈다.
//
// ★모양은 운영자와 제이크가 이 자리에서 조율해 정한다(운영자 판정, 2026-09-03).
//   앨리에게 넘기지 않는다. 정해진 것은 인수인계에 남긴다.
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="방 — Nuh-Muh">
  <div class="room" id="room" style="opacity:0;">

    <!-- 방에 들어오면 워드마크가 물러나고 엠블럼만 남는다. 자리를 벽에 내준다. -->
    <a href="/" class="seal" aria-label="너머로 돌아가기">
      <img src="/images/emblem.png" alt="" width="60" />
    </a>

    <p class="greet" id="greet">열쇠를 가진 이여.</p>

    <!-- 방 — 화면 전체. 원근이 여기 걸린다. -->
    <div class="box" id="box">
      <div class="walls" id="walls">

        <section class="wall front" data-face="front">
          <div class="inner">
            <h2 class="w-name">내가 거는 벽</h2>
            <div class="plate">
              <input type="text" id="plate" class="p-input" maxlength="60" placeholder="이 방을 무어라 부를지" />
              <button type="button" id="plate-save" class="p-save">건다</button>
              <p class="p-msg" id="plate-msg"></p>
            </div>
          </div>
        </section>

        <section class="wall right" data-face="right">
          <div class="inner">
            <h2 class="w-name">전시하는 벽</h2>
          </div>
        </section>

        <section class="wall back" data-face="back">
          <div class="inner">
            <h2 class="w-name">문이 둘인 벽</h2>
            <div class="pile" id="pile"></div>
          </div>
        </section>

        <section class="wall left" data-face="left">
          <div class="inner">
            <h2 class="w-name">만드는 벽</h2>
          </div>
        </section>

        <section class="wall bottom" data-face="bottom">
          <div class="inner">
            <h2 class="w-name">짐 가방</h2>
            <p class="w-sub">여기 둔 것은 남에게 보이지 않소.</p>
          </div>
        </section>

      </div>
    </div>
      <!-- 구역선과 사선 — 벽 위에 얹힌다. 굴리기의 기준 도형이다. -->
      <div class="frame" aria-hidden="true">
        <span class="gl gl-top"></span>
        <span class="gl gl-bot"></span>
        <span class="dg dg-tl"></span>
        <span class="dg dg-tr"></span>
        <span class="dg dg-bl"></span>
        <span class="dg dg-br"></span>
      </div>

    <!-- 돌리는 자리 — 화면 양 끝과 맨 아래. 화면 전체가 도는 느낌이 나게. -->
    <button type="button" class="turn edge-l" id="t-left" aria-label="왼쪽 벽으로"><span>‹</span></button>
    <button type="button" class="turn edge-r" id="t-right" aria-label="오른쪽 벽으로"><span>›</span></button>
    <button type="button" class="turn edge-d" id="t-down" aria-label="짐 가방으로"><span>⌄</span></button>

    <!-- 아래로 흐르는 것들 — 방 밑에 붙는다. -->
    <div class="below">
      <section class="trace">
        <h2 class="tr-title">발자취</h2>
        <div id="trace-body"><p class="empty">아직 남긴 것이 없소.</p></div>
      </section>

      <section class="keep">
        <button type="button" class="k-head" id="k-head">열쇠 바꾸기</button>
        <div class="k-body" id="k-body" style="display:none;">
          <label class="k-label">지금 봉인</label>
          <input type="password" id="pw-cur" class="k-input" autocomplete="current-password" />
          <label class="k-label">새 봉인 <span class="k-hint">8자 이상</span></label>
          <input type="password" id="pw-new" class="k-input" autocomplete="new-password" />
          <label class="k-label">새 봉인 다시</label>
          <input type="password" id="pw-new2" class="k-input" autocomplete="new-password" />
          <button type="button" id="pw-save" class="k-save">바꾼다</button>
          <p class="k-msg" id="pw-msg"></p>
        </div>
        <button type="button" class="k-out" id="logout">열쇠를 내려놓고 떠난다</button>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  /* ★방은 화면 전체다. BaseLayout의 container를 쓰지 않는다 —
     폭이 제한되면 "안에 서 있다"가 성립하지 않는다. */
  .room { position: relative; width: 100%; transition: opacity 0.7s ease; }

  /* 낙관 — 워드마크가 물러난 자리. 방에서는 이것만 남는다. */
  /* 낙관은 방의 한가운데 위에 걸린다. 흐리지 않다 — 이 방의 표식이다. */
  .seal { position: fixed; top: 1.6rem; left: 50%; margin-left: -30px; z-index: 20; display: block; }
  .seal img { display: block; }

  .greet { position: fixed; top: 1.6rem; left: 1.8rem; z-index: 20;
    font-family: 'EB Garamond', serif; font-style: italic; font-size: 0.95rem; color: var(--ink-soft); }

  /* ─────────────────────────────────────────────
     ★★원근 — 이 값이 "방 안에 서 있는 거리"를 정한다.
     크면 멀리서 구경하는 것이 되고(1차 시도의 실패), 작으면 안에 들어간다.
     화면 폭의 절반 수준으로 잡아 정면 벽은 평평하게 크고
     양옆 벽은 저절로 가파르게 기울어 가장자리로 빨려들어간다.
     ───────────────────────────────────────────── */
  /* ─────────────────────────────────────────────
     ★방의 치수는 한 벌이다. 하나만 바꾸면 정육면체가 깨진다.
       폭 = 깊이(정육면체), 깊이의 절반만큼 앞으로 당겨야 정면 벽이 화면에 선다.
     ★높이를 100vh보다 작게 잡는 것이 요점이다.
       꽉 채우면 옆벽이 넓어지는 부분이 화면 위아래로 나가 사선이 안 보인다.
       위아래에 남긴 여백에 그 사선이 드러난다 — 그것이 입체를 만든다.
     ★사선의 방향: 상자 안을 들여다보는 것이므로 가까운 쪽(화면 가장자리)이 넓고
       먼 쪽(정면 벽)이 좁다. 위 모서리는 가장자리에서 안쪽으로 내려오고
       아래 모서리는 올라간다. 원근이 알아서 그린다 — 우리가 선을 긋지 않는다.
     ───────────────────────────────────────────── */
  /* ─────────────────────────────────────────────
     ★3D가 아니다. 슬라이드다.
       앞선 시도들은 벽 다섯을 실제 공간에 배치하고 카메라를 돌렸다. 계산이 계속 어긋났고
       옆벽이 화면을 침범했으며 짐 가방이 뒤집혔다. 그 접근을 폐기했다.
     ★지금 구조: 화면에 벽 하나. 넘기면 내용만 바뀐다. 1→2→3→4→다시 1로 순환한다.
     ★입체는 '감'이다. 정면 벽 네 모서리에서 짧은 대각선이 화면 가장자리 쪽으로
       오므라들며 뻗는다 — 옆벽이 뒤로 물러나 있다는 암시일 뿐 실제 벽이 아니다.
       위 모서리 선은 아래로, 아래 모서리 선은 위로 향한다(운영자 확인).
     ───────────────────────────────────────────── */
  .box { position: relative; height: 100vh; overflow: hidden;
    /* 방의 치수는 한 벌이다. 여백과 사선 길이가 물려 있다.
       dg-len = mx / cos(26.57도) — 가로로 뻗는 길이가 mx와 같아야
       사선 끝이 화면 가장자리에 딱 닿는다. 하나만 바꾸면 어긋난다. */
    --mx: 4vw; --my: 5vh; --dg-len: 4.472vw; }

  /* 정면 벽 — 화면을 거의 채운다. 위아래 여백에 대각선이 놓인다. */
  .walls { position: absolute; inset: var(--my) var(--mx); }

  .wall {
    position: absolute; inset: 0;
    background: var(--paper-letter);
    border: 1px solid var(--edge);
    opacity: 0; pointer-events: none;
    transition: opacity 0.5s ease;
    overflow-y: auto;
  }
  .wall.facing { opacity: 1; pointer-events: auto; }

  /* ─────────────────────────────────────────────
     구역선(.gl) — 벽의 윗변·아랫변을 화면 끝까지 늘린 선.
       화면이 위·가운데·아래 세 층으로 갈리고, 벽이 그 층에 끼워진 것으로 읽힌다.
       ★사각형의 꼭짓점은 이 선을 벗어나지 않는다(운영자 확정). 굴릴 때도 마찬가지다 —
         높이는 변하지 않고 폭만 변한다. 이 선이 꼭짓점이 타고 다니는 레일이다.

     사선(.dg) — 옆 벽이 접혀서 눌린 모습이지 장식이 아니다.
       벽 모서리에서 시작해 화면 가장자리에 닿는다. 위 모서리 선은 아래로,
       아래 모서리 선은 위로 — 가장자리로 갈수록 위아래가 모인다(운영자 확정).
       ★사선과 사각형은 개념상 한 몸이다. 굴리면 사선이 누우면서 다음 정면의
         윗변·아랫변이 되고, 그 바깥에 새 사선이 열린다. 따로 움직이게 만들지 말 것.

     각도를 고정한다(26.57도). 이전 방식은 그라디언트 색 경계로 선을 흉내 냈는데,
       귀퉁이 사각형의 대각선으로 각도가 강제돼 창 비율에 따라 눕고 섰다. 게다가
       벽 모서리에 닿지 않고 허공에 떠 있었다.
     ───────────────────────────────────────────── */
  .frame { position: absolute; inset: 0; pointer-events: none; }
  .gl, .dg { position: absolute; height: 0; border-top: 1px solid var(--edge); }
  .gl { left: 0; right: 0; }
  .gl-top { top: var(--my); }
  .gl-bot { top: calc(100% - var(--my)); }
  .dg { width: var(--dg-len); transform-origin: 0 0; }
  .dg-tl { left: var(--mx);              top: var(--my);              transform: rotate(153.43deg); }
  .dg-tr { left: calc(100% - var(--mx)); top: var(--my);              transform: rotate(26.57deg); }
  .dg-bl { left: var(--mx);              top: calc(100% - var(--my)); transform: rotate(206.57deg); }
  .dg-br { left: calc(100% - var(--mx)); top: calc(100% - var(--my)); transform: rotate(-26.57deg); }

  /* 벽 안 — 위쪽에 구역이 서고 아래로 늘어난다. */
  .inner { padding: 3.4rem 3.4rem 2rem; }

  .w-name { font-family: 'Noto Serif KR', serif; font-size: 1.5rem; font-weight: 500; color: var(--ink); letter-spacing: 0.02em; }
  .w-name::after { content: ''; display: block; width: 2.6rem; border-top: 1.5px solid var(--mark); margin: 0.9rem 0 2rem; }
  .w-sub { font-family: 'Noto Serif KR', serif; font-size: 0.88rem; color: var(--ink-faint); margin-top: -1.2rem; margin-bottom: 2rem; }

  /* 문패 */
  .p-input { width: 100%; max-width: 22rem; font-family: 'Noto Serif KR', serif; font-size: 1rem; color: var(--ink);
    background: transparent; border: none; border-bottom: 1px solid var(--rule); padding: 0.5rem 0.1rem; }
  .p-input:focus { outline: none; border-color: var(--mark); }
  .p-input::placeholder { color: var(--ink-faint); font-style: italic; }
  .p-save { font-family: 'Noto Serif KR', serif; font-size: 0.85rem; color: var(--ink-soft);
    background: none; border: none; padding: 0.6rem 0; margin-top: 0.6rem; cursor: pointer; display: block;
    border-bottom: 1px solid var(--rule); transition: color 0.2s, border-color 0.2s; }
  .p-save:hover { color: var(--mark); border-color: var(--mark); }
  .p-save:disabled { opacity: 0.4; cursor: default; }
  .p-msg { font-family: 'EB Garamond', serif; font-style: italic; font-size: 0.9rem; color: var(--ink-soft); margin-top: 0.8rem; min-height: 1.2rem; }

  .pile .letter { max-width: 26rem; border-left: 1.5px solid var(--mark); padding: 0.2rem 0 0.2rem 1rem; margin-bottom: 1.2rem; }
  .pile .l-from { font-family: 'JetBrains Mono', monospace; font-size: 0.64rem; letter-spacing: 0.12em; color: var(--ink-faint); }
  .pile .l-body { font-family: 'Noto Serif KR', serif; font-size: 0.95rem; color: var(--ink); line-height: 1.9; margin-top: 0.4rem; }

  /* ─────────────────────────────────────────────
     돌리는 자리 — 화면 양 끝과 맨 아래.
     화면 전체가 도는 느낌을 위해 가장자리에 붙인다.
     ───────────────────────────────────────────── */
  .turn { position: fixed; z-index: 30; background: none; border: none; cursor: pointer;
    color: var(--ink-faint); transition: color 0.25s, background 0.35s; display: flex; align-items: center; justify-content: center; }
  .turn span { font-family: 'EB Garamond', serif; font-size: 2rem; line-height: 1; }
  .turn:hover { color: var(--mark); }
  .edge-l { left: 0; top: 0; bottom: 0; width: 4.5vw; }
  .edge-r { right: 0; top: 0; bottom: 0; width: 4.5vw; }
  .edge-l:hover { background: linear-gradient(to right, rgba(139,58,46,0.07), transparent); }
  .edge-r:hover { background: linear-gradient(to left,  rgba(139,58,46,0.07), transparent); }
  .edge-d { left: 4.5vw; right: 4.5vw; bottom: 0; height: 3.4rem; }
  .edge-d span { font-size: 1.6rem; }
  .edge-d:hover { background: linear-gradient(to top, rgba(139,58,46,0.07), transparent); }

  /* 아래로 흐르는 것 — 방 밑에 붙는다. 방을 다 본 뒤에 온다. */
  .below { max-width: 720px; margin: 0 auto; padding: 4rem 1.4rem 6rem; }
  .trace { border-top: 1px solid var(--rule); padding-top: 1.8rem; margin-bottom: 2.6rem; }
  .tr-title { font-family: 'Noto Serif KR', serif; font-size: 1.05rem; font-weight: 600; margin-bottom: 1rem; }
  .tr-week { margin-bottom: 1.1rem; }
  .tr-head { font-family: 'JetBrains Mono', monospace; font-size: 0.68rem; letter-spacing: 0.12em; color: var(--mark); margin-bottom: 0.4rem; }
  .tr-item { font-family: 'Noto Serif KR', serif; font-size: 0.9rem; padding: 0.25rem 0; }
  .tr-item a { color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--rule); }
  .tr-item a:hover { border-color: var(--mark); color: var(--mark); }
  .empty { font-family: 'EB Garamond', serif; font-style: italic; font-size: 0.9rem; color: var(--ink-faint); }

  .keep { border-top: 1px solid var(--rule); padding-top: 1.4rem; }
  .k-head, .k-out { font-family: 'Noto Serif KR', serif; font-size: 0.9rem; color: var(--ink-soft); background: none; border: none;
    padding: 0.5rem 0; cursor: pointer; display: block; text-align: left; transition: color 0.2s, padding-left 0.3s; }
  .k-head:hover, .k-out:hover { color: var(--mark); padding-left: 0.5rem; }
  .k-body { max-width: 380px; padding: 0.6rem 0 1rem; }
  .k-label { display: block; font-family: 'Noto Serif KR', serif; font-size: 0.85rem; color: var(--ink-soft); margin: 0.8rem 0 0.3rem; }
  .k-hint { font-family: 'EB Garamond', serif; font-style: italic; font-size: 0.75rem; color: var(--ink-faint); margin-left: 0.3rem; }
  .k-input { width: 100%; font-family: 'JetBrains Mono', monospace; font-size: 0.88rem; color: var(--ink);
    background: rgba(255,255,255,0.5); border: 1px solid var(--rule); padding: 0.5rem 0.6rem; }
  .k-input:focus { outline: none; border-color: var(--mark); }
  .k-save { font-family: 'Noto Serif KR', serif; font-size: 0.9rem; color: var(--paper-letter); background: var(--ink);
    border: none; padding: 0.55rem 1.2rem; margin-top: 1rem; cursor: pointer; }
  .k-save:disabled { opacity: 0.4; cursor: default; }
  .k-msg { font-family: 'EB Garamond', serif; font-style: italic; font-size: 0.9rem; color: var(--ink-soft); margin-top: 0.7rem; min-height: 1.2rem; }

  /* 좁은 화면 — 벽이 화면 폭을 넘지 않게. 원근은 더 짧게 잡아 깊이를 유지한다. */
  @media (max-width: 720px) {
    .box { --mx: 6vw; --my: 4vh; --dg-len: 6.708vw; }
    .inner { padding: 2rem 1.4rem; }
    .greet { display: none; }
  }
</style>

<script>
  import { supabase } from '../../lib/supabaseClient.js';

  const RING = ['front', 'right', 'back', 'left'];   // 좌우로 도는 것은 벽 넷

  async function initRoom() {
    const root = document.getElementById('room');
    const walls = document.getElementById('walls');
    if (!root || !walls) return;

    let session = null;
    try {
      const { data } = await supabase.auth.getSession();
      session = data ? data.session : null;
    } catch (e) {}
    if (!session) { window.location.href = '/'; return; }

    // 토큰은 쓰기 직전에 얻는다 — 로드 시점 사본을 가둬두지 않는다(§7-39).
    async function freshToken() {
      try {
        const { data } = await supabase.auth.getSession();
        if (data && data.session) return data.session.access_token;
      } catch (e) {}
      try {
        const { data: r } = await supabase.auth.refreshSession();
        if (r && r.session) return r.session.access_token;
      } catch (e) {}
      return null;
    }
    async function callRoom(payload) {
      const res = await fetch('/.netlify/functions/room', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.assign({ token: await freshToken() }, payload)),
      });
      return res.json();
    }

    const data = await callRoom({ action: 'get' });
    if (data.status !== 'ok') {
      const g = document.getElementById('greet');
      if (g) g.textContent = '안쪽이 조용하구려.';   // 공통 오류 세트 — 서버 무응답
      root.style.opacity = '1';
      return;
    }

    // ★문장 단위 교체. 이름 자리만 비우면 ", 오셨습니까"가 되어 깨진다(§5-20 선례).
    const greet = document.getElementById('greet');
    if (greet && data.nickname) greet.textContent = data.nickname + '님, 오셨습니까.';

    const plate = document.getElementById('plate');
    if (plate && data.room && data.room.nameplate) plate.value = data.room.nameplate;

    renderPile(data.door || []);
    renderTrace(data.trace || []);

    // ── 어느 벽을 보고 있나 ──
    let face = (data.room && data.room.last_face) || 'front';
    let down = (face === 'bottom');
    paint();
    root.style.opacity = '1';

    // 슬라이드다 — 회전값이 없다. 어느 벽을 보일지만 정한다.
    function paint() {
      const showing = down ? 'bottom' : face;
      walls.querySelectorAll('.wall').forEach((w) => {
        w.classList.toggle('facing', w.dataset.face === showing);
      });
    }
    let _lastWall = (face === 'bottom') ? 'front' : face;

    function turn(step) {
      if (down) { down = false; face = _lastWall; paint(); save(); return; }
      const i = RING.indexOf(face);
      face = RING[(i + step + RING.length) % RING.length];
      _lastWall = face;
      paint(); save();
    }
    function save() {
      callRoom({ action: 'face', face: down ? 'bottom' : face });
    }

    document.getElementById('t-left').addEventListener('click', () => turn(-1));
    document.getElementById('t-right').addEventListener('click', () => turn(1));
    document.getElementById('t-down').addEventListener('click', () => {
      down = !down;
      if (!down) face = _lastWall;
      paint(); save();
    });

    // 키보드로도 돌린다 — 화살표가 화면 가장자리에 있으니 손이 멀다.
    document.addEventListener('keydown', (e) => {
      if (e.target && /INPUT|TEXTAREA/.test(e.target.tagName)) return;
      if (e.key === 'ArrowLeft') turn(-1);
      else if (e.key === 'ArrowRight') turn(1);
      else if (e.key === 'ArrowDown' && !down) { down = true; paint(); save(); }
      else if (e.key === 'ArrowUp' && down) { down = false; face = _lastWall; paint(); save(); }
    });

    // ── 문패 ──
    const pSave = document.getElementById('plate-save');
    if (pSave) {
      pSave.addEventListener('click', async () => {
        const msg = document.getElementById('plate-msg');
        const label = pSave.textContent;
        pSave.disabled = true; pSave.textContent = '거는 중';
        const r = await callRoom({ action: 'nameplate', text: plate ? plate.value : '' });
        if (msg) msg.textContent = (r.status === 'ok') ? '걸어두었소.' : '무언가 어긋났소.';
        pSave.textContent = label; pSave.disabled = false;
      });
    }

    // ── 열쇠 바꾸기 (기존 비밀번호 변경 이전) ──
    const kHead = document.getElementById('k-head');
    const kBody = document.getElementById('k-body');
    if (kHead && kBody) {
      kHead.addEventListener('click', () => {
        kBody.style.display = (kBody.style.display === 'none') ? 'block' : 'none';
      });
    }
    const pwSave = document.getElementById('pw-save');
    if (pwSave) {
      pwSave.addEventListener('click', async () => {
        const cur = document.getElementById('pw-cur');
        const nw = document.getElementById('pw-new');
        const nw2 = document.getElementById('pw-new2');
        const msg = document.getElementById('pw-msg');
        // ★오류에 붉은색을 쓰지 않는다. 기존 화면의 #a33은 네 번째 붉은 계열이었고
        //   §3-17·§2-1-1에 양쪽 다 어긋났다. 옮기면서 걷어냈다 — 문구로만 알린다.
        const say = (m) => { if (msg) msg.textContent = m; };
        const c = cur ? cur.value : '', n = nw ? nw.value : '', n2 = nw2 ? nw2.value : '';
        if (!c || !n) { say('지금 봉인과 새 봉인을 적으시오.'); return; }
        if (n.length < 8) { say('새 봉인은 8자 이상이어야 하지.'); return; }
        if (n !== n2) { say('새 봉인이 서로 다르구려.'); return; }

        const label = pwSave.textContent;
        pwSave.disabled = true; pwSave.textContent = '바꾸는 중';
        try {
          const res = await fetch('/.netlify/functions/change-password', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ token: await freshToken(), currentPassword: c, newPassword: n }),
          });
          const d = await res.json();
          if (d.status === 'ok') {
            say('봉인을 바꾸었소.');
            if (cur) cur.value = ''; if (nw) nw.value = ''; if (nw2) nw2.value = '';
          } else {
            // ★서버 detail을 그대로 뿌리지 않는다. 기존 화면은 그대로 출력했고
            //   그러면 영문·기술 메시지가 사용자에게 노출된다(join은 통합 문구로 덮는데 반대였다).
            say('봉인을 바꾸지 못했소. 지금 봉인이 맞는지 살펴보시오.');
          }
        } catch (e) {
          say('거미가 길을 잃었군.');   // 공통 오류 세트 — 연결 끊김
        }
        pwSave.textContent = label; pwSave.disabled = false;
      });
    }

    const out = document.getElementById('logout');
    if (out) {
      out.addEventListener('click', async () => {
        out.textContent = '문을 닫는 중';
        try { await supabase.auth.signOut(); } catch (e) {}
        window.location.href = '/';
      });
    }
  }

  function renderPile(door) {
    const pile = document.getElementById('pile');
    if (!pile) return;
    const letters = door.filter(d => d.kind === 'letter');
    if (!letters.length) {
      pile.innerHTML = '<p class="empty">아직 아무것도 없소.</p>';
      return;
    }
    pile.innerHTML = '';
    letters.forEach((d) => {
      const box = document.createElement('div'); box.className = 'letter';
      const from = document.createElement('div'); from.className = 'l-from';
      from.textContent = '주인장이 놓고 감';
      const body = document.createElement('div'); body.className = 'l-body';
      body.textContent = d.body || '';
      box.appendChild(from); box.appendChild(body); pile.appendChild(box);
    });
  }

  // 발자취 — 넘기 단위로 모아 보여준다. 따로 쌓지 않는다(마틴 판정).
  function renderTrace(trace) {
    const el = document.getElementById('trace-body');
    if (!el || !trace.length) return;
    el.innerHTML = '';
    trace.forEach((w) => {
      const box = document.createElement('div'); box.className = 'tr-week';
      const head = document.createElement('div'); head.className = 'tr-head';
      // ★독자 표기는 반드시 "N번째 넘기". week·주차는 화면에 노출하지 않는다.
      head.textContent = (w.week == null) ? '넘기에 얹지 않은 것' : (w.week + '번째 넘기');
      box.appendChild(head);
      w.entries.forEach((e) => {
        const row = document.createElement('div'); row.className = 'tr-item';
        const a = document.createElement('a');
        a.href = '/' + e.slug; a.textContent = e.title;
        row.appendChild(a); box.appendChild(row);
      });
      el.appendChild(box);
    });
  }

  if (document.readyState !== 'loading') initRoom();
  else document.addEventListener('DOMContentLoaded', initRoom);
  document.addEventListener('astro:page-load', initRoom);
</script>
