---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { createClient } from '@supabase/supabase-js';

const supabase = createClient(
  process.env.SUPABASE_URL,
  process.env.SUPABASE_SECRET_KEY
);

const { slug } = Astro.params;

const { data: article } = await supabase
  .from('articles')
  .select('*')
  .eq('slug', slug)
  .eq('status', 'published')
  .maybeSingle();

if (!article) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const dateStr = article.created_at ? new Date(article.created_at).toLocaleDateString('ko-KR') : '';
---
<BaseLayout title={article.title + " — Nuh-Muh"}>
  <article class="art-wrap" id="art-wrap" data-article-id={article.id}>
    <a href="/" class="art-back">← 너머</a>

    <p class="art-category">{article.category}</p>
    <h1 class="art-title">{article.title}</h1>
    {article.subtitle && <p class="art-subtitle">{article.subtitle}</p>}

    <div class="art-meta">
      <span class="art-author">{article.author}</span>
      <span class="art-dot">·</span>
      <span class="art-date">{dateStr}</span>
    </div>

    {article.cover_image && (
      <img class="art-cover" src={article.cover_image} alt={article.cover_alt || ""} />
    )}

    <div class="art-body" set:html={article.body}></div>

    {article.tags && article.tags.length > 0 && (
      <div class="art-tags">
        {article.tags.map((t) => <span class="art-tag">{t}</span>)}
      </div>
    )}

    {article.work && (
      <p class="art-work">이 글은 「{article.work}」에 대한 글입니다.</p>
    )}
  </article>
</BaseLayout>

<style>
  .art-wrap { max-width: 680px; margin: 0 auto; padding: 3rem 1.2rem 6rem;
    position: relative; }   /* 담기 쪽지의 좌표 기준 */
  .art-back { font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; letter-spacing: 0.15em; color: var(--ink-soft); text-decoration: none; display: inline-block; margin-bottom: 3rem; }
  .art-back:hover { color: var(--mark); }
  .art-category { font-family: 'Cormorant Unicase', serif; font-size: 0.9rem; letter-spacing: 0.1em; color: var(--mark); margin-bottom: 0.8rem; }
  .art-title { font-family: 'Noto Serif KR', serif; font-weight: 600; font-size: 2.3rem; line-height: 1.3; margin-bottom: 0.8rem; }
  .art-subtitle { font-family: 'EB Garamond', serif; font-style: italic; font-size: 1.25rem; color: var(--ink-soft); line-height: 1.5; margin-bottom: 1.4rem; }
  .art-meta { font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; letter-spacing: 0.08em; color: var(--ink-faint); margin-bottom: 2.6rem; }
  .art-dot { margin: 0 0.5rem; }
  .art-cover { width: 100%; border-radius: 6px; margin-bottom: 2.6rem; }
  .art-body { font-family: 'Noto Serif KR', serif; font-weight: 400; font-size: 1.08rem; line-height: 1.95; color: var(--ink); }
  /* ★★문단 여백 0 — 간격은 빈 문단이 만든다 (2026-08-23 마틴 판정)
     기존 1.5rem은 엔터 한 번에도 붙어 "한 번 쳤는데 너무 벌어진다"의 원인이었다.
     line-height(1.95)는 만족 상태이므로 건드리지 않는다 — 벌어짐의 원인은 이 여백이었다.
     ★편집창(desk/index.astro의 .ed-editor :global(.ProseMirror p))과 짝이다. 한쪽만 고치지 말 것. */
  .art-body :global(p) { margin: 0; }
  /* 빈 문단이 한 줄 높이를 갖게 받침 */
  .art-body :global(p:empty) { min-height: 1.95em; }
  .art-body :global(h2) { font-size: 1.5rem; font-weight: 600; margin: 2.6rem 0 1rem; }
  .art-body :global(h3) { font-size: 1.25rem; font-weight: 600; margin: 2rem 0 0.8rem; }
  .art-body :global(img) { max-width: 100%; border-radius: 6px; margin: 1.6rem 0; }
  .art-body :global(img) { display: block; height: auto; }
  .art-body :global(img[data-size="xs"]) { max-width: 25%; }
  .art-body :global(img[data-size="sm"]) { max-width: 40%; }
  .art-body :global(img[data-size="md"]) { max-width: 60%; }
  .art-body :global(img[data-size="lg"]) { max-width: 80%; }
  .art-body :global(img[data-size="full"]) { max-width: 100%; }
  .art-body :global(img[data-align="left"]) { margin-right: auto; margin-left: 0; }
  .art-body :global(img[data-align="center"]) { margin-left: auto; margin-right: auto; }
  .art-body :global(img[data-align="right"]) { margin-left: auto; margin-right: 0; }
  .art-body :global(figure) { margin: 1.6rem 0; }
  .art-body :global(figure[data-size="xs"]) { max-width: 25%; }
  .art-body :global(figure[data-size="sm"]) { max-width: 40%; }
  .art-body :global(figure[data-size="md"]) { max-width: 60%; }
  .art-body :global(figure[data-size="lg"]) { max-width: 80%; }
  .art-body :global(figure[data-size="full"]) { max-width: 100%; }
  .art-body :global(figure[data-align="left"]) { margin-right: auto; margin-left: 0; }
  .art-body :global(figure[data-align="center"]) { margin-left: auto; margin-right: auto; }
  .art-body :global(figure[data-align="right"]) { margin-left: auto; margin-right: 0; }
  .art-body :global(figure img) { display: block; max-width: 100%; height: auto; margin: 0; }
  .art-body :global(figcaption) { font-size: 0.85rem; color: var(--ink-soft); margin-top: 0.5rem; line-height: 1.6; }
  .art-body :global(figure[data-align="left"] figcaption) { text-align: left; }
  .art-body :global(figure[data-align="center"] figcaption) { text-align: center; }
  .art-body :global(figure[data-align="right"] figcaption) { text-align: right; }
  .art-body :global(div[data-nm-group]) { margin: 1.6rem 0; }
  .art-body :global(div[data-nm-group][data-size="xs"]) { max-width: 40%; }
  .art-body :global(div[data-nm-group][data-size="sm"]) { max-width: 55%; }
  .art-body :global(div[data-nm-group][data-size="md"]) { max-width: 70%; }
  .art-body :global(div[data-nm-group][data-size="lg"]) { max-width: 85%; }
  .art-body :global(div[data-nm-group][data-size="full"]) { max-width: 100%; }
  .art-body :global(div[data-nm-group][data-align="left"]) { margin-right: auto; margin-left: 0; }
  .art-body :global(div[data-nm-group][data-align="center"]) { margin-left: auto; margin-right: auto; }
  .art-body :global(div[data-nm-group][data-align="right"]) { margin-left: auto; margin-right: 0; }
  .art-body :global(div[data-nm-group-row]) { display: flex; gap: 0.6rem; }
  .art-body :global(div[data-nm-group-row] img) { width: 50%; height: auto; object-fit: cover; display: block; margin: 0; border-radius: 6px; }
  .art-body :global(div[data-nm-group] figcaption) { display: flex; gap: 0.6rem; margin-top: 0.5rem; font-size: 0.85rem; color: var(--ink-soft); line-height: 1.6; }
  .art-body :global(div[data-nm-group] figcaption span) { width: 50%; text-align: center; }
  @media (max-width: 600px) {
    .art-body :global(div[data-nm-group]) { max-width: 100% !important; }
    .art-body :global(div[data-nm-group-row]) { flex-direction: column; }
    .art-body :global(div[data-nm-group-row] img) { width: 100%; }
  }
  .art-body :global(a) { color: var(--mark); text-underline-offset: 3px; }
  .art-body :global(blockquote) { border-left: 2px solid var(--mark); padding-left: 1.2rem; margin: 1.6rem 0; color: var(--ink-soft); font-style: italic; }
  .art-tags { margin-top: 3.5rem; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .art-tag { font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; color: var(--ink-soft); border: 1px solid var(--rule); border-radius: 999px; padding: 0.25rem 0.7rem; }
  .art-work { font-family: 'EB Garamond', serif; font-style: italic; font-size: 0.95rem; color: var(--ink-faint); margin-top: 2rem; }

  /* ─────────────────────────────────────────────
     담기 쪽지 — 문장을 고르면 그 자리 위에 뜬다.
     ★:global()이 필수다. 쪽지는 스크립트가 런타임에 만드는 노드라
       Astro 스코프 CSS의 표식이 없어 규칙이 안 걸린다(통합본 §8-10).
       안 붙이면 position: absolute가 무시돼 쪽지가 글 맨 아래에 찌부러진 채 놓인다.
     ★이 CSS는 있어도 무해하지만, 쪽지 자체는 열쇠가 확인된 뒤에만 만들어진다.
       비로그인 독자의 HTML에는 담기 관련 요소가 하나도 없다(마틴 확인 4번).
     ───────────────────────────────────────────── */
  :global(.keep-note) {
    position: absolute; z-index: 40; transform: translate(-50%, -100%);
    background: var(--paper-letter); border: 1px solid var(--rule-strong);
    padding: 0.34rem 0.8rem; cursor: pointer;
    font-family: 'Noto Serif KR', serif; font-size: 0.84rem; color: var(--ink);
    white-space: nowrap; opacity: 0; transition: opacity 0.16s ease;
    box-shadow: 0 2px 8px rgba(28,35,64,0.10);
  }
  :global(.keep-note.on) { opacity: 1; }
  :global(.keep-note:hover) { border-color: var(--mark); color: var(--mark); }
  :global(.keep-note.done) { cursor: default; color: var(--ink-soft); border-color: var(--rule); }
  :global(.keep-hint) {
    position: absolute; z-index: 40; transform: translate(-50%, 0.5rem);
    font-family: 'EB Garamond', serif; font-style: italic; font-size: 0.82rem;
    color: var(--ink-faint); white-space: nowrap; pointer-events: none;
    opacity: 0; transition: opacity 0.3s ease;
  }
  :global(.keep-hint.on) { opacity: 1; }
</style>

<script>
  import { supabase } from '../lib/supabaseClient.js';

  // ★담기 장치는 열쇠가 확인된 뒤에만 만들어진다. 숨기는 것이 아니라 존재하지 않는다 —
  //   "참여 장치는 자격이 있을 때만 존재한다"가 소스 층위까지 가야 한다(마틴).
  //   비로그인·initiate 독자가 받는 본문은 지금과 픽셀 하나 다르지 않다.
  async function initKeep() {
    const body = document.querySelector('.art-body');
    const wrap = document.getElementById('art-wrap');
    if (!body || !wrap || wrap.dataset.keepReady) return;

    let session = null;
    try { const { data } = await supabase.auth.getSession(); session = data ? data.session : null; }
    catch (e) {}
    if (!session) return;                       // 여기서 끝. 아무것도 만들지 않는다.

    async function freshToken() {
      try { const { data } = await supabase.auth.getSession();
            if (data && data.session) return data.session.access_token; } catch (e) {}
      try { const { data: r } = await supabase.auth.refreshSession();
            if (r && r.session) return r.session.access_token; } catch (e) {}
      return null;
    }
    async function call(payload) {
      const res = await fetch('/.netlify/functions/keep', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.assign({ token: await freshToken() }, payload)),
      });
      return res.json();
    }

    const seen = await call({ action: 'moments' });
    if (seen.status !== 'ok') return;           // keyholder가 아니면 서버가 막는다
    const moments = new Set(seen.moments || []);
    wrap.dataset.keepReady = '1';

    const articleId = Number(wrap.dataset.articleId);
    const note = document.createElement('button');
    note.type = 'button'; note.className = 'keep-note'; note.textContent = '담기';
    wrap.appendChild(note);
    const hint = document.createElement('div');
    hint.className = 'keep-hint';
    wrap.appendChild(hint);

    let pending = null;
    const hide = () => { note.classList.remove('on'); note.classList.remove('done');
                         note.textContent = '담기'; pending = null; };
    const sayHint = (text) => {
      hint.textContent = text; hint.classList.add('on');
      setTimeout(() => hint.classList.remove('on'), 3200);
    };

    // ★빈 문단에는 담기 장치를 붙이지 않는다.
    //   빈 문단도 앵커를 받고, 이미지마다 하나씩 자동으로 생긴다.
    //   운영자가 만든 빈 줄과 도구가 만든 빈 문단은 성격이 다르나 구분할 수 없으므로
    //   내용 없는 문단은 전부 제외한다(마틴 판정).
    function blockOf(node) {
      let el = node.nodeType === 3 ? node.parentElement : node;
      while (el && el !== body) {
        if (el.hasAttribute && el.hasAttribute('data-anchor')) return el;
        el = el.parentElement;
      }
      return null;
    }

    document.addEventListener('selectionchange', () => {
      const sel = document.getSelection();
      if (!sel || sel.isCollapsed || sel.rangeCount === 0) { hide(); return; }
      const range = sel.getRangeAt(0);
      if (!body.contains(range.commonAncestorContainer)) { hide(); return; }

      const text = sel.toString().trim();
      if (!text) { hide(); return; }

      const block = blockOf(range.startContainer);
      if (!block || !block.textContent.trim()) { hide(); return; }   // 빈 문단 제외

      // 문단 안에서 몇 번째 글자부터인지 — 원문이 고쳐져도 문단까지는 앵커로 도달한다.
      let start = null, end = null;
      try {
        const pre = range.cloneRange();
        pre.selectNodeContents(block);
        pre.setEnd(range.startContainer, range.startOffset);
        start = pre.toString().length;
        end = start + sel.toString().length;
      } catch (e) {}

      pending = { anchor_id: block.getAttribute('data-anchor'),
                  start_offset: start, end_offset: end, snapshot_text: text };

      const r = range.getBoundingClientRect();
      const w = wrap.getBoundingClientRect();
      note.style.left = (r.left + r.width / 2 - w.left) + 'px';
      note.style.top = (r.top - w.top - 8) + 'px';
      note.classList.add('on');

      if (!moments.has('first-drag')) {
        moments.add('first-drag');
        call({ action: 'first', moment: 'first-drag' });
        hint.style.left = note.style.left;
        hint.style.top = (r.bottom - w.top) + 'px';
        sayHint('담으면 네 방에 놓인다');
      }
    });

    note.addEventListener('mousedown', (e) => e.preventDefault());   // 선택이 풀리지 않게
    note.addEventListener('click', async () => {
      if (!pending || note.classList.contains('done')) return;
      const p = pending;
      note.textContent = '담는 중';
      const r = await call(Object.assign({ action: 'keep', article_id: articleId }, p));
      if (r.status === 'ok' || r.status === 'already') {
        note.textContent = (r.status === 'already') ? '이미 담았소' : '담았소';
        note.classList.add('done');
        if (r.status === 'ok' && !moments.has('first-keep')) {
          moments.add('first-keep');
          call({ action: 'first', moment: 'first-keep' });
          hint.style.left = note.style.left;
          hint.style.top = note.style.top;
          sayHint('네 방에 들어갔다. 너만 볼 수 있다.');
        }
        setTimeout(hide, 1400);
      } else {
        note.textContent = '무언가 어긋났소';   // 공통 오류 세트 — 미분류 실패
        note.classList.add('done');
        setTimeout(hide, 1800);
      }
    });
  }

  if (document.readyState !== 'loading') initKeep();
  else document.addEventListener('DOMContentLoaded', initKeep);
  document.addEventListener('astro:page-load', initKeep);
</script>
