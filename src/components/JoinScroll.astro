---
---
<section class="join-scroll" id="join-scroll" aria-hidden="true">
  <div class="scroll-paper" id="scroll-paper">
    <div class="scroll-inner">
      <p class="join-title">열쇠를 받는 자리</p>
      <p class="join-sub">그쪽 주소는 이미 우리에게 있소. 이제 봉인을 정하시오.</p>
      <!-- novalidate: 브라우저 기본 말풍선(세계관 밖 문자열)을 끄고 우리 문구로 대체.
           required·type=email은 접근성·의미론을 위해 그대로 둔다. -->
      <form class="join-form" id="join-form" novalidate>
        <input type="email" id="join-email" placeholder="엽서에 남긴 주소" autocomplete="off" required />
        <div class="join-field">
          <input type="text" id="join-nick" placeholder="사용할 이름" autocomplete="off" required />
          <!-- 사전 안내: 허용 외 문자가 설명 없이 지워져 버그로 오인되는 것을 여기서 막는다.
               "지워진다"고 쓰지 않은 것은 의도 — 사용자 눈에는 애초에 입력이 안 되는 것으로 보인다. -->
          <p class="join-hint">소문자·숫자·한글과 -, _ 만 새길 수 있소.</p>
        </div>
        <div class="join-field">
          <input type="password" id="join-pass" placeholder="봉인 암호" autocomplete="off" required />
          <p class="join-hint">봉인 암호는 8자 이상.</p>
        </div>
        <button type="submit" class="join-submit" id="join-submit">봉인한다</button>
      </form>
      <p class="join-msg" id="join-msg"></p>
      <!-- 공통 오류 세트의 재시도 버튼. 미분류 실패에서만 노출된다. -->
      <button type="button" class="join-retry" id="join-retry" style="display:none;">다시</button>
    </div>
  </div>
</section>

<style>
  .join-scroll {
    width: 100%;
    display: flex;
    justify-content: center;
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.7s cubic-bezier(0.5, 0, 0.3, 1);
    padding: 0 1.2rem;
  }
  /* 1단계: 공간만 열림 (종이는 아직 clip으로 숨겨짐) */
  .join-scroll.space {
    max-height: 700px;
    padding: 2rem 1.2rem 5rem;
  }

  .scroll-paper {
    width: 100%;
    max-width: 460px;
    background: var(--paper);
    border: 1px solid var(--rule-strong);
    box-shadow: 0 20px 50px rgba(28, 35, 64, 0.22);
    /* 위에서 아래로 풀려 내려오는 두루마리 — 처음엔 완전히 가려짐 */
    clip-path: inset(0 0 100% 0);
    transition: clip-path 1.1s cubic-bezier(0.45, 0.05, 0.3, 1);
    position: relative;
  }
  /* 2단계: 종이가 풀려 내려옴 */
  .join-scroll.unfurl .scroll-paper {
    clip-path: inset(0 0 0 0);
  }
  .scroll-paper::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    opacity: 0.05; mix-blend-mode: multiply;
  }
  /* 안쪽 액자선 (두 줄 테두리) */
  .scroll-paper::after {
    content: ''; position: absolute;
    inset: 7px;
    border: 1px solid var(--rule-strong);
    pointer-events: none;
  }

  .scroll-inner {
    padding: 3rem 2.5rem 2.8rem;
    text-align: center;
  }
  .join-title {
    font-family: 'Noto Serif KR', serif;
    font-size: 1.5rem; font-weight: 400;
    color: var(--ink); margin-bottom: 0.8rem;
  }
  .join-sub {
    font-family: 'EB Garamond', serif; font-style: italic;
    font-size: 1rem; color: var(--ink-soft);
    margin-bottom: 2.2rem; line-height: 1.6;
  }
  .join-form {
    display: flex; flex-direction: column; gap: 1rem;
    align-items: stretch;
  }
  .join-form input {
    font-family: 'EB Garamond', serif;
    font-size: 1rem; padding: 0.8rem 1rem;
    background: transparent;
    border: none; border-bottom: 1px solid var(--rule-strong);
    color: var(--ink); text-align: center;
    outline: none; transition: border-color 0.3s;
  }
  .join-form input:focus { border-color: var(--mark); }
  .join-form input::placeholder { color: var(--ink-faint); font-style: italic; }
  .join-submit {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem; letter-spacing: 0.25em; text-transform: uppercase;
    padding: 0.9rem; margin-top: 0.6rem;
    background: var(--ink); color: var(--paper);
    border: none; cursor: pointer;
    transition: background 0.3s;
  }
  .join-submit:hover { background: var(--mark); }
  /* 입력란 + 사전 안내를 묶는 래퍼 (폼이 flex column이라 안내가 붙어 있게) */
  .join-field { display: flex; flex-direction: column; gap: 0.35rem; }
  /* 사전 안내 — 작고 옅은 잉크색. 오류가 아니라 미리 알려주는 말이다. */
  .join-hint {
    font-family: 'Noto Serif KR', serif;
    font-size: 0.78rem; line-height: 1.5;
    color: var(--ink-faint); text-align: center;
    margin: 0; word-break: keep-all;
  }
  .join-msg {
    font-family: 'Noto Serif KR', serif;
    font-size: 0.95rem; line-height: 1.7; color: var(--ink-faint);
    margin-top: 1.2rem; min-height: 1.2em; word-break: keep-all;
  }
  /* 공통 오류 세트의 재시도 버튼 — 오류에 붉은색을 쓰지 않는다(잉크색 유지) */
  .join-retry {
    margin-top: 0.9rem;
    background: none; border: 1px solid var(--rule-strong); cursor: pointer;
    font-family: 'Noto Serif KR', serif; font-size: 0.85rem; color: var(--ink);
    padding: 0.45rem 1.5rem; transition: border-color 0.3s;
  }
  .join-retry:hover { border-color: var(--ink); }
</style>

<script>
  import { supabase } from '../lib/supabaseClient.js';
  function initJoinScroll() {
    const section = document.getElementById('join-scroll');
    const trigger = document.getElementById('signup-box');
    if (!section || !trigger) return;

    trigger.addEventListener('click', function () {
      // 1단계: 빈 공간 열기
      section.classList.add('space');
      section.setAttribute('aria-hidden', 'false');
      // 공간 펼침(0.7s)이 끝난 뒤 스크롤 — 페이지가 다 길어진 후라야 끝까지 감
      setTimeout(function () {
        window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
      }, 750);
      // 2단계: 스크롤 도착 후 종이 펼침
      setTimeout(function () {
        window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
        section.classList.add('unfurl');
      }, 1500);
    });

    // 폼 제출 → join 함수 호출
    const form = document.getElementById('join-form');
    const msg = document.getElementById('join-msg');
    const emailEl = document.getElementById('join-email');
    const nickEl = document.getElementById('join-nick');
    if (nickEl) {
      var composing = false;
      var normalizeNick = function () {
        nickEl.value = nickEl.value.toLowerCase().replace(/[^a-z0-9가-힣_-]/g, '');
      };
      nickEl.addEventListener('compositionstart', function () { composing = true; });
      nickEl.addEventListener('compositionend', function () {
        composing = false;
        normalizeNick(); // 한글 조합이 끝난 뒤 정규화
      });
      nickEl.addEventListener('input', function () {
        if (!composing) normalizeNick(); // 조합 중이 아닐 때(영문·숫자 등)만 즉시 정규화
      });
    }
    const passEl = document.getElementById('join-pass');
    const submitBtn = document.getElementById('join-submit');

    if (form) {
      // ── 공통 오류 세트 (화면 무관, 돌려 씀) ──
      // 미분류 실패에만 쓴다. 서버가 이유를 말해주는 판정 오류는 자기 문구를 유지한다.
      // ★오류에 붉은색을 쓰지 않는다 — 시스템 경고의 문법이며 이 세계의 것이 아니다.
      var ERR = {
        offline: '거미가 길을 잃었군.',   // 네트워크 단절
        server:  '안쪽이 조용하구려.',     // 서버 무응답·5xx·타임아웃
        unknown: '무언가 어긋났소.',       // 파싱 실패·정체불명
      };
      var retryBtn = document.getElementById('join-retry');
      function showRetry(on) { if (retryBtn) retryBtn.style.display = on ? '' : 'none'; }

      // ── 자체 검증 (브라우저 기본 말풍선 대체) ──
      // novalidate로 말풍선을 껐으므로 우리가 검사하고 우리 문구를 띄운다.
      // ★첫 문제 칸으로 포커스를 옮기는 것이 필수 — 없으면 "제출했는데 아무 반응이 없다"가 된다.
      //   포커스 이동 시 브라우저가 스크롤까지 처리한다(폼이 두루마리 안에 있어 필요).
      function validateLocal() {
        var emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailEl.value.trim()) return { el: emailEl, msg: '엽서에 남긴 주소를 적으시오.' };
        if (!emailRe.test(emailEl.value.trim())) return { el: emailEl, msg: '올바른 주소가 아니군.' };
        if (!nickEl.value.trim()) return { el: nickEl, msg: '어떻게 부르면 좋겠소?' };
        if (!passEl.value) return { el: passEl, msg: '봉인 암호를 정하시오.' };
        return null;
      }

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        showRetry(false);

        var bad = validateLocal();
        if (bad) {
          msg.textContent = bad.msg;
          bad.el.focus();
          return;
        }

        // 제출 중 표시는 버튼 라벨 교체로 — 메시지 자리는 오류가 뜨는 곳이므로
        // 진행과 오류가 같은 자리에서 읽히지 않게 한다(엽서 "놓는다→다가오는 중"과 통일).
        var origLabel = submitBtn ? submitBtn.textContent : '';
        if (submitBtn) { submitBtn.textContent = '봉인하는 중'; submitBtn.disabled = true; }
        msg.textContent = '';

        let result = 'error';
        let errKind = null;   // 미분류 실패일 때만 채운다
        if (navigator.onLine === false) {
          errKind = 'offline';
        } else {
          try {
            const res = await fetch('/.netlify/functions/join', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                email: emailEl.value,
                password: passEl.value,
                nickname: nickEl.value,
              }),
            });
            if (!res.ok) {
              errKind = 'server';
            } else {
              try {
                const data = await res.json();
                result = data.status;
              } catch (e2) {
                errKind = 'unknown';
              }
            }
          } catch (err) {
            errKind = 'offline';
          }
        }

        if (submitBtn) { submitBtn.textContent = origLabel; submitBtn.disabled = false; }

        // 미분류 실패 → 공통 오류 세트 + 재시도 버튼
        if (errKind) {
          msg.textContent = ERR[errKind];
          showRetry(true);
          return;
        }

        if (result === 'ok') {
          msg.textContent = '봉인했소. 확인의 편지를 보냈으니, 메일함과 스팸함을 살펴 문을 여시오.';
          form.style.display = 'none';
          // ── 확인 감지 (마틴 안 C: 폴링 5분 + 탭 복귀 재확인) ──
          // 폴링은 짧은 지연을 즉시 잡고, 복귀 감지는 긴 지연(메일이 몇십 분 늦게 와도)을 잡는다.
          // ★창을 늘리는 대신 사용자의 실제 행동(탭으로 돌아옴)을 포착하는 설계 —
          //   "얼마면 충분한가"라는 답 없는 질문을 피한다.
          var pollEmail = emailEl.value;
          var pollPassword = passEl.value;
          var pollCount = 0;
          var pollMax = 75; // 4초 * 75 = 약 5분 (B가 뒤를 받치므로 늘리지 않는다)
          var pollTimer = null;
          var settled = false;   // 성공 후 재호출 차단 — 탭을 여러 번 오가도 호출 0
          var checking = false;  // 진행 중 중복 요청 차단 — 빠른 탭 전환에도 동시 요청 없음

          // 인터벌과 복귀 감지가 같은 함수를 공유한다(두 경로가 갈라져 어긋나는 것 방지)
          async function checkConfirmed() {
            if (settled || checking) return;
            checking = true;
            try {
              const res = await fetch('/.netlify/functions/confirm', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: pollEmail }),
              });
              const data = await res.json();
              if (data.status === 'ok') {
                settled = true;
                if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
                document.removeEventListener('visibilitychange', onVisible);
                window.removeEventListener('focus', checkConfirmed);
                msg.textContent = '문이 열리오…';
                // 확인 완료 → 이 화면이 갖고 있던 비번으로 로그인 → 세션 생성
                try {
                  await supabase.auth.signInWithPassword({
                    email: pollEmail, password: pollPassword,
                  });
                } catch (e2) {}
                setTimeout(function () {
                  window.scrollTo({ top: 0, behavior: 'smooth' });
                  setTimeout(function () { location.reload(); }, 900);
                }, 1200);
              }
            } catch (e) {}
            checking = false;
          }

          // (B) 탭 복귀 재확인 — 사용자가 다른 기기에서 링크를 누르고 이 탭으로 돌아온 순간을 포착.
          //     지연이 몇 시간이어도 작동한다. 숨겨질 때는 돌지 않는다.
          function onVisible() {
            if (document.visibilityState === 'visible') checkConfirmed();
          }
          document.addEventListener('visibilitychange', onVisible);
          // 창을 나란히 띄워 둘 다 계속 '보이는' 상태면 visibilitychange가 발동하지 않는다.
          // (클릭은 포커스만 바꿀 뿐 보임/안보임을 바꾸지 않음) → focus로 그 구멍을 메운다.
          // 중복 호출은 checking/settled가 막으므로 안전하다.
          window.addEventListener('focus', checkConfirmed);

          // (A) 폴링 — 같은 기기에서 곧바로 확인한 경우를 즉시 처리하는 보조.
          pollTimer = setInterval(function () {
            pollCount++;
            if (pollCount > pollMax) {
              clearInterval(pollTimer); pollTimer = null;
              // ★성격이 "실패 안내"가 아니라 "기다림의 표시"다(앨리 A-2 확정).
              //   복귀 감지를 문구로 설명하지 않는다 — 사용자가 알 필요 없는 기계 동작이며,
              //   메일이 도착하면 그 메일이 다음 행동을 전부 말한다.
              //   시각적으로도 오류처럼 보이지 않게 할 것(공통 오류 세트의 톤과 구분).
              msg.textContent = '편지가 아직 안 갔나? 가끔 늦으니, 도착하거든 열쇠를 받아 오시오. 영 안 오거든 입구에서 다시 청하시고.';
              return;
            }
            checkConfirmed();
          }, 4000);
        } else if (result === 'ok_no_mail') {
          // 자동 재발송이 폐지됐으므로 "재발송을 기다리라"는 안내를 쓰지 않는다.
          msg.textContent = '봉인은 되었으나, 거미가 편지를 물고 나서지 못했군. 잠시 뒤 다시 보내보시오.';
          form.style.display = 'none';
        } else if (result === 'not_initiate') {
          // "엽서를 남기시오"를 뺀 것은 의도 — 거미를 거쳐야 이 폼에 닿으므로
          // 여기 온 사람은 이미 엽서를 남겼다. 남은 원인은 주소 오타·착각뿐이다.
          // (오타 주소로 엽서를 다시 남기게 하면 명부만 오염된다.)
          msg.textContent = '아, 이 주소로는 엽서를 보낸 적이 없군. 엽서에 남긴 주소가 맞는지 살펴보시오.';
        } else if (result === 'already_keyholder') {
          // ⑦ members.status === 'keyholder' — 진짜 정식 회원
          msg.textContent = '당신은 이미 열쇠가 있는데? 거, 안 들어오고 뭐 하시오?';
        } else if (result === 'account_exists') {
          // ⑧ Auth에만 계정이 있는 상태 — keyholder가 아니다. ⑦과 판정 근거가 다르다.
          // 이 사용자는 완전한 막다른 골목이므로 연락 창구가 필요하다.
          // ★mailto가 차단되는 환경이 있으므로 주소가 눈으로도 읽혀야 한다(A-1과 동일 처리).
          msg.innerHTML = '이런, 이 주소로 이미 누군가 봉인을 정했소.<br>당신이 한 일이 아니라면 알려주시오. '
            + '<a href="mailto:desk@nuh-muh.com?subject=%EC%9E%98%EB%AA%BB%EB%90%9C%20%ED%8E%B8%EC%A7%80" style="color:inherit;">desk@nuh-muh.com</a>';
        } else if (result === 'weak_password') {
          msg.textContent = '암호는 8자 이상이어야 하지.';
        } else if (result === 'no_nickname') {
          msg.textContent = '어떻게 부르면 좋겠소?';
        } else if (result === 'bad_nickname') {
          msg.textContent = '이름은 두 글자에서 스무 글자 사이, 소문자·숫자·한글과 -, _ 만 쓸 수 있소.';
        } else if (result === 'nickname_taken') {
          msg.textContent = '이미 누군가 쓰고 있는 이름이오. 다른 이름을 정하시오.';
        } else if (result === 'invalid_email') {
          msg.textContent = '올바른 주소가 아니군.';
        } else {
          // 여기까지 오면 서버가 이유를 말하지 않은 실패다 → 공통 오류 세트
          msg.textContent = ERR.unknown;
          showRetry(true);
        }
      });

      // 공통 오류 세트의 재시도 — 폼을 다시 제출한다.
      if (retryBtn) {
        retryBtn.addEventListener('click', function () {
          showRetry(false);
          form.dispatchEvent(new Event('submit', { cancelable: true }));
        });
      }
    }
  }
  if (document.readyState !== 'loading') initJoinScroll();
  else document.addEventListener('DOMContentLoaded', initJoinScroll);
  document.addEventListener('astro:page-load', initJoinScroll);
</script>
